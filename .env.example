# Archil backend (optional). Without ARCHIL_API_KEY, Delta runs on the local APFS-clone backend.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-west-2
# Optional: reuse an existing disk instead of creating "delta-worlds" (free plan = 5 disks).
ARCHIL_DISK_ID=
# Optional: also take a real Archil disk checkpoint on every snapshot (cannot be deleted later).
ARCHIL_CHECKPOINTS=0

# Optional: real LLM agents (claude-opus-5-5). Without it, agents run in deterministic scripted mode.
ANTHROPIC_API_KEY=

# Optional tuning
PORT=5177
DELTA_PACE_MS=350

# Optional: Keenable web search for the Enricher agent (https://docs.keenable.ai). Without it the web step is skipped.
KEENABLE_API_KEY=
# KEENABLE_KEYLESS=1   # use Keenable's keyless public endpoint instead (shared per-IP limits)
# DELTA_KEENABLE_MAX=25
